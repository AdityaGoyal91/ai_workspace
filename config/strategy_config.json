{
  "objective": "Outperform blended index benchmark with one decision window per trading day.",
  "benchmark": {
    "components": [
      {"ticker": "SPY", "weight": 0.5},
      {"ticker": "QQQ", "weight": 0.3},
      {"ticker": "DIA", "weight": 0.2}
    ],
    "rebalanced": "monthly"
  },
  "target_outperformance": {
    "min_annualized_alpha": 0.005,
    "stretch_annualized_alpha": 0.02
  },
  "execution_constraints": {
    "decision_windows_per_day": 1,
    "timezone": "America/New_York",
    "preferred_decision_time": "15:30"
  }
}
